Язык="-РУС"

# Обычная программа и точный SAT в одном языке.
функция фибоначчи(n):
    если n < 2:
        вернуть n

    пусть a = 0
    пусть b = 1

    для i в диапазон(2, n + 1):
        пусть следующее = a + b
        a = b
        b = следующее

    вернуть b

печать("fib(10) =", фибоначчи(10))

импорт крипто
печать("sha256 =", крипто.hash("LabScript"))

импорт сат
пусть ответ = сат.solve(2, [[1, 2], [-1, 2]])
печать("SAT =", ответ["sat"])
